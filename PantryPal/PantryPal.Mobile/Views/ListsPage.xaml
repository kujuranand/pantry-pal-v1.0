<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PantryPal.Mobile.Views.ListsPage"
    Title="Lists">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New" Clicked="OnNewListClicked" />
    </ContentPage.ToolbarItems>

    <!-- More generous padding + clear row layout -->
    <Grid Padding="16" RowSpacing="12"
          RowDefinitions="Auto,Auto,Auto,*">

        <!-- 0: Section title -->
        <Label Text="Your grocery lists"
               FontAttributes="Bold"
               FontSize="18"
               Margin="0,0,0,4" />

        <!-- 1: Search -->
        <SearchBar
            x:Name="ListSearchBar"
            Grid.Row="1"
            Placeholder="Search lists..."
            Margin="0,0,0,4"
            TextChanged="OnSearchTextChanged" />

        <!-- 2: Sort controls -->
        <HorizontalStackLayout Grid.Row="2"
                               Spacing="16"
                               VerticalOptions="Center"
                               Margin="0,0,0,4">
            <Label Text="Sort:" VerticalTextAlignment="Center" />
            <RadioButton x:Name="SortNewest"
                         Content="Newest"
                         GroupName="ListSort"
                         IsChecked="True"
                         CheckedChanged="OnSortCheckedChanged" />
            <RadioButton x:Name="SortOldest"
                         Content="Oldest"
                         GroupName="ListSort"
                         CheckedChanged="OnSortCheckedChanged" />
        </HorizontalStackLayout>

        <!-- 3: Lists -->
        <CollectionView
            x:Name="ListsCollection"
            Grid.Row="3"
            ItemsSource="{Binding}"
            SelectionMode="Single"
            SelectionChanged="OnSelectionChanged">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32" Spacing="8">
                    <Label Text="No lists yet" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" />
                    <Label Text="Tap 'New' to create your first list." HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Rename" BackgroundColor="#2196F3" Invoked="OnRenameSwipe" />
                                <SwipeItem Text="Delete" BackgroundColor="#E53935" IsDestructive="True" Invoked="OnDeleteSwipe" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Grid Padding="12"
                              ColumnDefinitions="*,Auto"
                              Margin="0,0,0,8"
                              BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2B2B2B}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <HorizontalStackLayout Spacing="16">
                                    <Label Text="{Binding CreatedDisplay}" Opacity="0.7" />
                                    <Label Text="{Binding TotalDisplay}" Opacity="0.7" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Open"
                                    VerticalOptions="Center"
                                    Clicked="OnOpenClicked" />
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
